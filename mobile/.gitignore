# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config — identifies a specific project (adya-technologies-erp)
# and isn't meant to travel with the source tree. Supply it per-environment
# the same way backend.env/frontend.env are handled (see ../COOLIFY.md):
# an Azure DevOps Secure File copied into place during the pipeline, or a
# local copy for `flutter run` on your own machine.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Play Store release signing. Losing this keystore means losing the
# ability to ever publish an update to the same Play Store listing — keep
# your own backup somewhere safe (a password manager's file storage, not
# just this machine), it must never be regenerated after the first upload.
android/key.properties
android/app/upload-keystore.jks
